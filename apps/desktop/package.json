{
  "name": "@tlc/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop account-team intelligence powered by MSX and Microsoft Foundry agents.",
  "author": "TLC MultiAgent Assist contributors",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "dependencies": {
    "@azure/ai-projects": "^2.5.0",
    "@azure/identity": "^4.13.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "docx": "^9.7.1",
    "pdf-parse": "^2.4.5",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "4.4.3"
  },
  "build": {
    "appId": "com.tlc.multiagentassist",
    "productName": "TLC MultiAgent Assist",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "dist/revamp/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../config/foundry.environment.default.json",
        "to": "config/foundry.environment.default.json"
      },
      {
        "from": "../../config/mcp.servers.json",
        "to": "config/mcp.servers.json"
      },
      {
        "from": "../../config/mcp.tool-policy.json",
        "to": "config/mcp.tool-policy.json"
      },
      {
        "from": "../../config/dataverse.entity-map.json",
        "to": "config/dataverse.entity-map.json"
      },
      {
        "from": "../../docs/knowledge/MCEM Overview.pdf",
        "to": "docs/knowledge/MCEM Overview.pdf"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TLC-MultiAgent-Assist-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "jszip": "^3.10.1"
  }
}
