# Local developer preview. No live source network is used in sample mode.
TLC_TEAMS_MODE=sample
TLC_TEAMS_PORT=3978
TLC_TEAMS_ORIGIN=http://127.0.0.1:3978
TLC_TEAMS_ADMISSION=enabled

# For Teams sideloading, replace the origin with the approved HTTPS ingress/tunnel.
# Live mode requires separate approved A (API), B (SPA), C (bot) registrations.
TLC_TEAMS_TENANT_ID=REPLACE_WITH_CORPORATE_TENANT_GUID
TLC_TEAMS_API_CLIENT_ID=REPLACE_WITH_API_A_GUID
TLC_TEAMS_SPA_CLIENT_ID=REPLACE_WITH_SPA_B_GUID
TLC_TEAMS_BOT_CLIENT_ID=REPLACE_WITH_BOT_C_GUID
TLC_TEAMS_PACKAGE_ID=REPLACE_WITH_TEAMS_CATALOG_APP_GUID
TLC_TEAMS_API_CREDENTIAL=REPLACE_WITH_APPROVED_SERVER_CREDENTIAL
TLC_TEAMS_BOT_CREDENTIAL=REPLACE_WITH_APPROVED_BOT_CREDENTIAL
TLC_TEAMS_STATE_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
TLC_TEAMS_ENVIRONMENT_ID=REPLACE_WITH_APPROVED_ENVIRONMENT_NAME
TLC_TEAMS_MSX_RESOURCE=https://REPLACE.crm.dynamics.com
TLC_TEAMS_MCP_SCOPE=https://REPLACE.crm.dynamics.com/mcp.tools
TLC_TEAMS_STORAGE_URL=https://REPLACE.table.core.windows.net
TLC_TEAMS_DISCLOSURE_POLICY=REPLACE_WITH_PROTECTED_POLICY_FILE_PATH

# Hosted Foundry configuration uses the existing loader and workload identity.
# TLC_FOUNDRY_ENV_FILE=REPLACE_WITH_PROTECTED_FOUNDRY_CONFIGURATION_PATH
# AZURE_CLIENT_ID=REPLACE_WITH_USER_ASSIGNED_MANAGED_IDENTITY_GUID
# TLC_TEAMS_HOST=0.0.0.0
