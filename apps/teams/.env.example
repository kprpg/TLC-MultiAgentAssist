# Local developer preview. No live source network is used in sample mode.
TLC_TEAMS_MODE=sample
# Sample business data uses Foundry AI by default; failures have a labeled offline fallback.
# Set TLC_AI_MODE=sample for credential-free offline AI.
TLC_AI_MODE=foundry
# Mode selection is per personal page. Live is unavailable until its runtime is configured.
# On a configured Live runtime, open Sample first without source access:
# TLC_TEAMS_INITIAL_MODE=sample
TLC_TEAMS_RUNTIME_PROFILE=local
TLC_TEAMS_PORT=3978
TLC_TEAMS_ORIGIN=http://127.0.0.1:3978
TLC_TEAMS_ADMISSION=enabled
# Optional technical performance events, disabled by default.
# TLC_TEAMS_PERFORMANCE=1
# Optional confirmed background admission; requires protected durable runtime state.
# Keep state/keys when disabling so private receipts remain recoverable.
TLC_BACKGROUND_SYNC=0

# Optional direct localhost HTTPS using an already trusted PEM certificate/key.
# No certificate is generated or trusted automatically. With these set, use an HTTPS origin.
# TLC_TEAMS_TLS_CERT_PATH=C:\APPROVED_CERT_FOLDER\localhost.pem
# TLC_TEAMS_TLS_KEY_PATH=C:\PROTECTED_KEY_FOLDER\localhost-key.pem

# Defaults persist outside the release directory under LOCALAPPDATA\TLC-Assist\Teams.
# Set an approved, access-controlled directory if the default is unsuitable.
# TLC_TEAMS_DATA_DIR=C:\Users\YOUR_USER\AppData\Local\TLC-Assist\Teams

# For Teams sideloading, replace the origin with the approved HTTPS ingress/tunnel.
# The hosted-obo live profile below requires approved A (API), B (SPA), C (bot).
# For one native Windows installation per user instead, use .env.native.example;
# it has no mandatory API/SPA/bot secret, central backend, or source CLI fallback.
# TLC_TEAMS_AUTH_MODE=hosted-obo
TLC_TEAMS_TENANT_ID=REPLACE_WITH_CORPORATE_TENANT_GUID
TLC_TEAMS_API_CLIENT_ID=REPLACE_WITH_API_A_GUID
TLC_TEAMS_SPA_CLIENT_ID=REPLACE_WITH_SPA_B_GUID
TLC_TEAMS_BOT_CLIENT_ID=REPLACE_WITH_BOT_C_GUID
TLC_TEAMS_PACKAGE_ID=REPLACE_WITH_TEAMS_CATALOG_APP_GUID
TLC_TEAMS_API_CREDENTIAL=REPLACE_WITH_APPROVED_SERVER_CREDENTIAL
TLC_TEAMS_BOT_CREDENTIAL=REPLACE_WITH_APPROVED_BOT_CREDENTIAL
TLC_TEAMS_STATE_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
TLC_TEAMS_ENVIRONMENT_ID=REPLACE_WITH_APPROVED_ENVIRONMENT_NAME
TLC_TEAMS_MSX_RESOURCE=https://REPLACE.crm.dynamics.com
TLC_TEAMS_MCP_SCOPE=https://REPLACE.crm.dynamics.com/mcp.tools
TLC_TEAMS_DISCLOSURE_POLICY=REPLACE_WITH_PROTECTED_POLICY_FILE_PATH

# Live local mode uses encrypted SQLite and AzureCliCredential for Foundry only.
# Sign in with Azure CLI to the Foundry tenant and obtain its required project role.
# Source MSX/MCP/Graph tokens still come from each user's delegated API assertion.
# TLC_FOUNDRY_ENV_FILE=REPLACE_WITH_PROTECTED_FOUNDRY_CONFIGURATION_PATH

# For a later Azure deployment, change the profile to azure and configure these.
# No managed identity or Table Storage is required by the local profile.
# TLC_TEAMS_STORAGE_URL=https://REPLACE.table.core.windows.net
# AZURE_CLIENT_ID=REPLACE_WITH_USER_ASSIGNED_MANAGED_IDENTITY_GUID
# TLC_TEAMS_HOST=0.0.0.0
