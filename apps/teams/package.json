{
  "name": "@tlc/teams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.client.config.ts && vite build --config vite.server.config.ts",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "start": "node --experimental-sqlite dist/server.js",
    "start:configured": "node --env-file=.env.local --experimental-sqlite dist/server.js"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/msal-browser": "5.25.1",
    "@azure/msal-node": "^5.6.0",
    "@microsoft/teams-js": "2.58.0",
    "@microsoft/teams.apps": "2.1.1",
    "express": "^5.1.0",
    "jose": "6.2.12",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
