# Per-user Windows installation. No shared TLC backend, app secret or token broker.
# Copy outside the repository/runtime release; replace coordinates with an approved native app.
TLC_TEAMS_MODE=live
# Optional technical performance events, disabled by default.
# TLC_TEAMS_PERFORMANCE=1
# Optional: open sanitized SQLite Sample first; select Live in the same Teams page later.
# TLC_TEAMS_INITIAL_MODE=sample
TLC_TEAMS_AUTH_MODE=local-interactive
TLC_TEAMS_RUNTIME_PROFILE=local
TLC_TEAMS_ORIGIN=https://localhost:3978
TLC_TEAMS_PORT=3978
TLC_TEAMS_HOST=127.0.0.1
TLC_TEAMS_ADMISSION=enabled
TLC_TEAMS_PACKAGE_ID=REPLACE_WITH_TEAMS_CATALOG_APP_GUID
TLC_TEAMS_TENANT_ID=REPLACE_WITH_APPROVED_CORPORATE_TENANT_GUID
TLC_TEAMS_NATIVE_CLIENT_ID=REPLACE_WITH_APPROVED_NATIVE_CLIENT_D_GUID
TLC_TEAMS_NATIVE_REDIRECT_URI=http://localhost
TLC_TEAMS_ENVIRONMENT_ID=REPLACE_WITH_APPROVED_ENVIRONMENT_NAME
TLC_TEAMS_MSX_RESOURCE=https://REPLACE.crm.dynamics.com
TLC_TEAMS_MCP_SCOPE=https://REPLACE.crm.dynamics.com/mcp.tools
TLC_TEAMS_GUIDANCE_MODE=deterministic

# The launcher prepares an owner/SYSTEM-only directory and persistent state key.
# Never paste downstream tokens, use an API/bot secret or select an implicit CLI fallback.
# Native ID tokens must carry the approved IAM-backed TLC.Teams.User role.
# Source writes additionally need TLC.Teams.Writer, actual source ACLs and exact review.
# TLC_TEAMS_OWNER_DIRECTORY=C:\Users\YOUR_USER\AppData\Local\TLC-Assist\Teams\launcher-native\private

# Supplied trusted PEM pair; the launcher accepts -CertificatePath/-PrivateKeyPath instead.
# TLC_TEAMS_TLS_CERT_PATH=C:\APPROVED_CERT_FOLDER\localhost.pem
# TLC_TEAMS_TLS_KEY_PATH=C:\PROTECTED_KEY_FOLDER\localhost-key.pem

# Optional separate delegated grants. No automatic Graph sign-in or cloud subscription.
# TLC_TEAMS_GRAPH_SCOPES=https://graph.microsoft.com/OnlineMeetings.Read https://graph.microsoft.com/OnlineMeetingTranscript.Read.All

# Optional explicit Foundry guidance instead of deterministic live guidance:
# TLC_TEAMS_GUIDANCE_MODE=foundry
# TLC_FOUNDRY_ENV_FILE=C:\PROTECTED_CONFIGURATION_FOLDER\foundry.environment.json
# This workload identity is separate from the native MSX/MCP/Graph identity.
# Optional confirmed background saves; 0 preserves acknowledged behavior.
# Existing protected durable state is required; retain it for recovery when disabled.
TLC_BACKGROUND_SYNC=0
