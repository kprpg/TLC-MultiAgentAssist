# Private per-user Windows CLI profile. No native/API/SPA/bot registration or secret.
# Copy outside the repository and replace the public tenant/source coordinates.
TLC_TEAMS_MODE=live
# Optional: open sanitized SQLite Sample first; select Live in the same Teams page later.
# Startup and Sample never connect to MSX. Live still needs explicit owner connection/pairing.
# TLC_TEAMS_INITIAL_MODE=sample
TLC_TEAMS_AUTH_MODE=local-azure-cli
# Every write still requires owner pairing, exact review/approval and source permission.
# Use read-only to disable source writes independently of the review gate.
TLC_TEAMS_CLI_WRITE_MODE=reviewed
TLC_TEAMS_RUNTIME_PROFILE=local
TLC_TEAMS_ORIGIN=https://localhost:3978
TLC_TEAMS_PORT=3978
TLC_TEAMS_HOST=127.0.0.1
TLC_TEAMS_ADMISSION=enabled
TLC_TEAMS_PACKAGE_ID=8cb8c9a2-6ee6-4382-bfa4-5b409c77e54b
TLC_TEAMS_TENANT_ID=REPLACE_WITH_CURRENT_CORPORATE_CLI_TENANT_GUID
TLC_TEAMS_ENVIRONMENT_ID=REPLACE_WITH_APPROVED_ENVIRONMENT_NAME
TLC_TEAMS_MSX_RESOURCE=https://REPLACE.crm.dynamics.com
TLC_TEAMS_GUIDANCE_MODE=deterministic

# The end user connects through the owner command. Startup never requests a source token.
# The signed delegated token and WhoAmI mapping determine the user, not an entered ID/email.
# No inferred FTE/application roles, Graph grant or cloud publication.
# MCP is optional and never connected by startup or an HTTP request:
# .\scripts\teams-local-connection.ps1 -Action Connect -Resource mcp -WorkDirectory "$env:LOCALAPPDATA\TLC-Assist\Teams\launcher-cli"
# Uses the current user's existing Dataverse /.default grant; MCP admission/policy still apply.
# Reviewed writes reuse the same MSX connector/orchestrator operations as Desktop.
# The launcher keeps data/control keys in its owner/SYSTEM-only private directory.
