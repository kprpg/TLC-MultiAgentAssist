{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TLC Teams (sample, F5)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/teams/dist/server.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--experimental-sqlite"],
      "env": {
        "TLC_TEAMS_MODE": "sample",
        "TLC_TEAMS_RUNTIME_PROFILE": "local",
        "TLC_TEAMS_ORIGIN": "http://127.0.0.1:3978",
        "TLC_TEAMS_PORT": "3978"
      },
      "outFiles": ["${workspaceFolder}/apps/teams/dist/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "build-teams",
      "serverReadyAction": { "pattern": "TLC Teams ready at (https?://[^ ]+)", "uriFormat": "%s", "action": "openExternally" }
    },
    {
      "name": "TLC Teams (live, approved environment)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/teams/dist/server.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--experimental-sqlite"],
      "envFile": "${workspaceFolder}/apps/teams/.env.local",
      "env": { "TLC_TEAMS_MODE": "live", "TLC_TEAMS_RUNTIME_PROFILE": "local" },
      "outFiles": ["${workspaceFolder}/apps/teams/dist/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "build-teams"
    },
    {
      "name": "TLC Teams (HTTPS tunnel, sample)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/teams/dist/server.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--experimental-sqlite"],
      "envFile": "${workspaceFolder}/apps/teams/.env.teams-dev",
      "env": { "TLC_TEAMS_MODE": "sample", "TLC_TEAMS_RUNTIME_PROFILE": "local" },
      "outFiles": ["${workspaceFolder}/apps/teams/dist/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "build-teams"
    },
    {
      "name": "Run TLC Assist Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "build-vscode-extension"
    },
    {
      "name": "Run TLC Assist Extension (SQLite test store)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "env": {
        "TLC_MODE": "sample",
        "TLC_DATA_STORE": "sqlite"
      },
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "build-vscode-extension"
    },
    {
      "name": "Run TLC Assist Extension (SQLite + Foundry extraction)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "env": {
        "TLC_MODE": "sample",
        "TLC_DATA_STORE": "sqlite",
        "TLC_MEETING_EXTRACTOR": "foundry",
        "TLC_MEETING_MODEL": "gpt-6.1-sol"
      },
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "build-vscode-extension"
    },
    {
      "name": "Run TLC Assist Extension (Live MSX/Dataverse)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "env": {
        "TLC_MODE": "live"
      },
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "build-vscode-extension"
    },
    {
      "name": "TLC Assist Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension",
        "--extensionTestsPath=${workspaceFolder}/apps/vscode-extension/test"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/dist/**/*.cjs"],
      "preLaunchTask": "build-vscode-extension"
    }
  ]
}
